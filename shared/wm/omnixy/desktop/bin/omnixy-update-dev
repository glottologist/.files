#!/bin/bash

# omnixy:summary=Update the active Omnixy dev checkout

set -euo pipefail

[[ $OMNIXY_PATH != "/usr/share/omnixy" ]] || exit 0

if ! git -C "$OMNIXY_PATH" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  echo "Error: OMNIXY_PATH is not a git checkout: $OMNIXY_PATH" >&2
  exit 1
fi

upstream=$(git -C "$OMNIXY_PATH" rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null || true)
if [[ -z $upstream ]]; then
  echo -e "\e[33m\nSkip Omnixy dev checkout update (current branch has no upstream)\e[0m"
  exit 0
fi

echo -e "\e[32m\nUpdate Omnixy dev checkout\e[0m"
git -C "$OMNIXY_PATH" pull --ff-only
