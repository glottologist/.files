#!/bin/bash

# omnixy:summary=Toggle microphone mute. Drives the hardware mic-mute LED on laptops that expose one.

wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle >/dev/null

if wpctl get-volume @DEFAULT_AUDIO_SOURCE@ | grep -q MUTED; then
  omnixy-brightness-keyboard-mute on
  omnixy-osd -i microphone-muted -m "Microphone muted"
else
  omnixy-brightness-keyboard-mute off
  omnixy-osd -i microphone -m "Microphone on"
fi
