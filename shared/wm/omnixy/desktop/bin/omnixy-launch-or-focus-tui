#!/bin/bash

# omnixy:summary=Launch a TUI or focus an existing terminal window for it
# omnixy:args=[--app-id=<app-id>] <command> [args...]

if [[ ${1:-} == --app-id=* ]]; then
  APP_ID="${1#--app-id=}"
else
  APP_ID="org.omnixy.$(basename "$1")"
fi

LAUNCH_COMMAND="omnixy-launch-tui $@"

exec omnixy-launch-or-focus "$APP_ID" "$LAUNCH_COMMAND"
