#!/bin/bash

# omnixy:summary=Apply the current theme keyboard color to ASUS ROG keyboards
# omnixy:hidden=true

ASUSCTL_THEME=$HOME/.local/state/omnixy/current/theme/keyboard.rgb

if omnixy-cmd-present asusctl && [[ -f $ASUSCTL_THEME ]]; then
  color=$(sed 's/^#//' "$ASUSCTL_THEME")
  [[ $color =~ ^[0-9A-Fa-f]{6}$ ]] || exit 0
  asusctl aura effect static -c "$color"
fi
