#!/bin/bash

# omnixy:summary=Print the active Omnixy package channel

set -euo pipefail

# Dev is a linked source checkout: OMNIXY_PATH points somewhere other than
# the package-backed install at /usr/share/omnixy. This takes precedence over
# the package channels, since the checkout overrides whatever is installed.
if [[ $OMNIXY_PATH != "/usr/share/omnixy" ]]; then
  echo dev
  exit 0
fi

# omnixy-dev / omnixy-settings-dev are only shipped from the edge package
# repo, so their presence alone means edge. omnixy / omnixy-settings come
# from either the stable or rc mirror, distinguished by omnixy-version-channel
# (which reports the mirror as its first token).
if pacman -Q omnixy-dev omnixy-settings-dev >/dev/null 2>&1; then
  echo edge
elif pacman -Q omnixy omnixy-settings >/dev/null 2>&1; then
  channel=$(omnixy-version-channel 2>/dev/null | awk '{ print $1 }')
  case "$channel" in
    stable) echo stable ;;
    rc) echo rc ;;
    *) echo unknown ;;
  esac
else
  echo unknown
fi
