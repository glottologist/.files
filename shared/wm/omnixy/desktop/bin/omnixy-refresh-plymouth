#!/bin/bash

# omnixy:summary=Overwrite the user config for the Plymouth drive decryption and boot sequence with the Omnixy default and rebuild it.
# omnixy:requires-sudo=true

# Reuse the fixed-file publisher so root never resolves the source checkout or
# follows a destination symlink while restoring the packaged assets.
exec "$OMNIXY_PATH/bin/omnixy-plymouth-set" --refresh-default
