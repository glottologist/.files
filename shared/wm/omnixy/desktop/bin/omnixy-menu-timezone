#!/bin/bash

# omnixy:summary=Select and set the system timezone
# omnixy:group=menu
# omnixy:name=timezone

set -e

timezone=$(timedatectl list-timezones | omnixy-menu-select "Set timezone" -- --width 520 --maxheight 520) || exit 1
sudo timedatectl set-timezone "$timezone"
omnixy-shell -q omnixy.clock refresh
omnixy-notification-send "Timezone is now set to $timezone"
