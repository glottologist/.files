#!/bin/bash

# omnixy:summary=Log out after closing application windows
# omnixy:examples=omnixy logout | omnixy system logout
# omnixy:aliases=omnixy logout

nohup bash -c "sleep 2 && uwsm stop" >/dev/null 2>&1 &

omnixy-osd -i logout -m "Logging out" -d 5000

# Now close all windows
omnixy-hyprland-window-close-all
sleep 1 # Allow apps like Chrome to shutdown correctly
