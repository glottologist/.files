#!/bin/bash

# omnixy:summary=Launch or focus on a given web app identified by the window-pattern.
# omnixy:args=<window-pattern> <url-and-flags...>

if (($# == 0)); then
  echo "Usage: omnixy-launch-or-focus-webapp [window-pattern] [url-and-flags...]"
  exit 1
fi

WINDOW_PATTERN="$1"
shift
LAUNCH_COMMAND="omnixy-launch-webapp $@"

exec omnixy-launch-or-focus "$WINDOW_PATTERN" "$LAUNCH_COMMAND"
