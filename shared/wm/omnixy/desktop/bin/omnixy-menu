#!/bin/bash

# omnixy:summary=Control the Omnixy menu (toggle / summon / close / refresh)
# omnixy:args=[toggle|summon|close|refresh|ping] [route]
# omnixy:examples=omnixy menu | omnixy menu toggle system | omnixy menu summon style.theme | omnixy menu refresh

# Thin wrapper around the standard plugin IPC surface. The menu is the
# first-party `omnixy.menu` plugin; routes are passed as JSON payload.

set -euo pipefail

verb="${1-toggle}"
route="${2-root}"

menu_payload() {
  jq -nc --arg menu "$1" '{ menu: $menu }'
}

case "$verb" in
  toggle)
    exec omnixy-shell shell toggle omnixy.menu "$(menu_payload "$route")"
    ;;
  summon)
    exec omnixy-shell shell summon omnixy.menu "$(menu_payload "$route")"
    ;;
  close)
    exec omnixy-shell shell hide omnixy.menu
    ;;
  refresh | ping)
    exec omnixy-shell shell call omnixy.menu "$verb" "{}"
    ;;
  -h | --help | help)
    cat <<USAGE
Usage: omnixy menu [verb] [route]

Verbs:
  toggle [route]   Open the menu at <route>, or close it if already open. Default verb.
  summon [route]   Always open the menu (no close-if-visible toggle).
  close            Close the menu if it is visible.
  refresh          Re-parse the menu JSONC files.
  ping             Health check.

Route is an item id (e.g. setup.power) or alias (e.g. power). Defaults to
"root", which opens the top-level menu.
USAGE
    exit 0
    ;;
  *)
    echo "omnixy-menu: unknown verb '$verb'. Try 'omnixy menu --help'." >&2
    exit 2
    ;;
esac
