#!/bin/bash

# omnixy:summary=Send the low battery warning notification and run battery-low hooks.
# omnixy:args=<percentage>
# omnixy:hidden=true

set -euo pipefail

if (($# != 1)); then
  echo "Usage: omnixy-battery-low <percentage>" >&2
  exit 1
fi

level=$1

omnixy-notification-send -g 󱐋 -u critical "Time to recharge!" "Battery is down to ${level}%" -i battery-caution -t 30000
omnixy-hook battery-low "$level"
