#!/bin/bash

# omnixy:summary=List themes that can style the Plymouth boot screen
# omnixy:examples=omnixy plymouth list

{
  find ~/.config/omnixy/themes/ -mindepth 1 -maxdepth 1 \( -type d -o -type l \) -printf '%f\n' 2>/dev/null
  find "$OMNIXY_PATH/themes/" -mindepth 1 -maxdepth 1 -type d -printf '%f\n'
} | sort -u | while read -r name; do
  if [[ -f $(omnixy-theme-dir "$name")/preview-unlock.png ]]; then
    echo "$name"
  fi
done
