#!/bin/bash

# omnixy:summary=Toggle crash capture notifications

# nf-md-robot_dead, escaped so this file reads without a Nerd Font.
readonly CRASH_GLYPH=$'\U000f16a1'

omnixy-toggle crash-capture-off

# The unit checks the same flag with ConditionPathExists, so stopping and
# starting only settles this session; the next login reads the flag itself.
if omnixy-toggle-enabled crash-capture-off; then
  systemctl --user stop omnixy-crash-watch.service
  omnixy-notification-send -g "$CRASH_GLYPH" "Crash capture disabled"
else
  systemctl --user start omnixy-crash-watch.service
  omnixy-notification-send -g "$CRASH_GLYPH" "Crash capture enabled"
fi
