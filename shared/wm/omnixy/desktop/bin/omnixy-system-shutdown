#!/bin/bash

# omnixy:summary=Shut down after closing application windows
# omnixy:examples=omnixy shutdown | omnixy system shutdown
# omnixy:aliases=omnixy shutdown

# Schedule the shutdown in the user manager so closing the terminal's systemd
# scope cannot terminate it before it runs.
systemd-run --user --collect --quiet --on-active="2s" --timer-property=AccuracySec=100ms systemctl poweroff --no-wall || exit 1

omnixy-osd -i shutdown -m "Shutting down" -d 5000

omnixy-state clear re*-required

# Now close all windows
omnixy-hyprland-window-close-all
sleep 1 # Allow apps like Chrome to shutdown correctly
