{
  // Omnixy menu definition.
  // JSONC is used for Neovim-friendly highlighting, comments, and trailing commas.
  // IDs are object keys. Dotted IDs imply hierarchy: trigger.share.file belongs
  // under trigger.share.
  // Kind is inferred: action -> action, target -> link, otherwise submenu.
  // Dotted IDs define the tree. Use provider:"name" only when the submenu
  // calls provider_name() or a command named "name" to return JSON rows.
  // Optional fields:
  //   aliases        alternate `omnixy menu summon <name>` routes; also searchable.
  //                  Reserved for established names users already type; new entries
  //                  should not normally add any.
  //   iconFont       font family used for the icon glyph, when it differs from the menu font
  //   title          header text shown when the submenu is open; defaults to label
  //   when           shell condition; hide row when it fails
  //   checked        shell condition; append ✓ when it succeeds

  // Root Menu
  "apps": {"icon":"󰀻","label":"Apps","aliases":["app","applications"],"provider":"apps"},
  "learn": {"icon":"󰧑","label":"Learn"},
  "trigger": {"icon":"󱓞","label":"Trigger"},
  "style": {"icon":"","label":"Style"},
  "setup": {"icon":"","label":"Setup","aliases":["settings"]},
  "about": {"icon":"","label":"About","action":"omnixy-launch-about"},
  "system": {"icon":"","label":"System","aliases":["power-menu"]},

  // System
  "system.screensaver": {"icon":"󱄄","label":"Screensaver","action":"omnixy-launch-screensaver force"},
  "system.lock": {"icon":"","label":"Lock","action":"omnixy-system-lock"},
  "system.suspend": {"icon":"󰒲","label":"Suspend","when":"! omnixy-toggle-enabled suspend-off","action":"systemctl suspend"},
  "system.hibernate": {"icon":"󰤁","label":"Hibernate","when":"omnixy-hibernation-available","action":"systemctl hibernate"},
  "system.logout": {"icon":"󰍃","label":"Logout","action":"omnixy-system-logout"},
  "system.reboot": {"icon":"󰜉","label":"Reboot","action":"omnixy-system-reboot"},
  "system.shutdown": {"icon":"󰐥","label":"Shutdown","action":"omnixy-system-shutdown"},

  // Learn
  "learn.keybindings": {"icon":"","label":"Keybindings","action":"omnixy-menu-keybindings"},
  "learn.omnixy": {"icon":"","label":"Omnixy","action":"omnixy-launch-webapp 'https://omarchy.org/manual/'"},
  "learn.hyprland": {"icon":"","label":"Hyprland","action":"omnixy-launch-webapp 'https://wiki.hypr.land/'"},
  "learn.arch": {"icon":"󰣇","label":"Arch","action":"omnixy-launch-webapp 'https://wiki.archlinux.org/title/Main_page'"},
  "learn.neovim": {"icon":"","label":"Neovim","action":"omnixy-launch-webapp 'https://www.lazyvim.org/keymaps'"},
  "learn.bash": {"icon":"󱆃","label":"Bash","action":"omnixy-launch-webapp 'https://devhints.io/bash'"},
  "learn.tmux-keybindings": {"icon":"","label":"Tmux","action":"omnixy-menu-tmux-keybindings"},
  "learn.herdr-keybindings": {"icon":"","label":"Herdr","action":"omnixy-menu-herdr-keybindings"},
  "learn.community": {"icon":"󰙯","label":"Community","action":"omnixy-launch-discord-community"},

  // Trigger
  "trigger.emoji": {"icon":"","label":"Emoji","aliases":["emoji","emojis"],"action":"omnixy-menu-emoji"},
  "trigger.reminder": {"icon":"󰢌","label":"Reminder","aliases":["reminder"]},
  "trigger.capture": {"icon":"","label":"Capture","aliases":["capture","screenshot","screenrecord","screen-record","screenrecording"]},
  "trigger.capture.screenshot": {"icon":"","label":"Screenshot","action":"omnixy-capture-screenshot"},
  "trigger.capture.screenrecord.stop": {"icon":"","label":"Stop Screenrecording","when":"pgrep -f '^gpu-screen-recorder'","action":"omnixy-capture-screenrecording --stop-recording"},
  "trigger.capture.screenrecord": {"icon":"","label":"Screenrecord"},
  "trigger.capture.text": {"icon":"󰴑","label":"Text","action":"omnixy-capture-text"},
  "trigger.capture.qr": {"icon":"󰐲","label":"QR Code","action":"omnixy-capture-qr"},
  "trigger.capture.color": {"icon":"󰃉","label":"Color","action":"pkill hyprpicker || hyprpicker -a"},
  "trigger.capture.screenrecord.no-audio": {"icon":"","label":"With no audio","action":"omnixy-capture-screenrecording"},
  "trigger.capture.screenrecord.desktop-audio": {"icon":"","label":"With desktop audio","action":"omnixy-capture-screenrecording --with-desktop-audio"},
  "trigger.capture.screenrecord.microphone": {"icon":"","label":"With desktop + microphone audio","action":"omnixy-capture-screenrecording --with-desktop-audio --with-microphone-audio"},
  "trigger.capture.screenrecord.webcam": {"icon":"","label":"With desktop + microphone audio + webcam","when":"omnixy-hw-webcam","action":"omnixy-capture-screenrecording-with-webcam"},
  "trigger.transcode": {"icon":"󰧸","label":"Transcode","action":"omnixy-transcode"},
  "trigger.share": {"icon":"","label":"Share","aliases":["share"]},
  "trigger.toggle": {"icon":"󰔎","label":"Toggle","aliases":["toggle","toggles"]},
  "trigger.hardware": {"icon":"","label":"Hardware","aliases":["hardware","hw"]},
  "trigger.tests": {"icon":"󰓅","label":"Speed Test"},
  "trigger.hardware.laptop-display": {"icon":"󰛧","label":"Laptop Display","when":"omnixy-hw-laptop","action":"omnixy-hyprland-monitor-internal toggle"},
  "trigger.hardware.mirror-display": {"icon":"󰍹","label":"Mirror Display","when":"omnixy-hw-laptop","action":"omnixy-hyprland-monitor-internal-mirror toggle"},
  "trigger.hardware.hybrid-gpu": {"icon":"","label":"Hybrid GPU","when":"omnixy-hw-hybrid-gpu","action":"omnixy-launch-floating-terminal-with-presentation omnixy-toggle-hybrid-gpu"},
  "trigger.hardware.touchpad": {"icon":"󰟸","label":"Touchpad","when":"omnixy-hw-touchpad","action":"omnixy-toggle-touchpad"},
  "trigger.hardware.touchpad-haptics": {"icon":"󰌌","label":"Touchpad Haptics"},
  "trigger.hardware.touchpad-haptics.low": {"icon":"󰌌","label":"low","when":"omnixy-hw-dell-xps-haptic-touchpad && omnixy-cmd-present dell-xps-touchpad-haptics","checked":"[[ \"$(dell-xps-touchpad-haptics get)\" == \"low\" ]]","action":"dell-xps-touchpad-haptics set low"},
  "trigger.hardware.touchpad-haptics.mid": {"icon":"󰌌","label":"mid","when":"omnixy-hw-dell-xps-haptic-touchpad && omnixy-cmd-present dell-xps-touchpad-haptics","checked":"[[ \"$(dell-xps-touchpad-haptics get)\" == \"mid\" ]]","action":"dell-xps-touchpad-haptics set mid"},
  "trigger.hardware.touchpad-haptics.high": {"icon":"󰌌","label":"high","when":"omnixy-hw-dell-xps-haptic-touchpad && omnixy-cmd-present dell-xps-touchpad-haptics","checked":"[[ \"$(dell-xps-touchpad-haptics get)\" == \"high\" ]]","action":"dell-xps-touchpad-haptics set high"},
  "trigger.hardware.touchscreen": {"icon":"󰆽","label":"Touchscreen","when":"omnixy-hw-touchscreen","action":"omnixy-toggle-touchscreen"},
  "trigger.reminder.set": {"icon":"󰢌","label":"Set one","aliases":["reminder-set","remind"],"action":"omnixy-reminder -i"},
  "trigger.reminder.show": {"icon":"󰢌","label":"Show all","action":"omnixy-reminder show"},
  "trigger.reminder.clear": {"icon":"󰢌","label":"Clear all","action":"omnixy-reminder clear"},
  "trigger.share.clipboard": {"icon":"","label":"Clipboard","action":"omnixy-menu-share clipboard"},
  "trigger.share.file": {"icon":"","label":"File","action":"omnixy-menu-share file"},
  "trigger.share.folder": {"icon":"","label":"Folder","action":"omnixy-menu-share folder"},
  "trigger.share.receive": {"icon":"󰥦","label":"Receive","action":"uwsm-app -- localsend"},
  "trigger.toggle.idle-lock": {"icon":"󰅶","label":"Stay Awake","action":"omnixy-toggle-idle"},
  "trigger.toggle.notifications": {"icon":"󰂛","label":"Notifications","action":"omnixy-toggle-notification-silencing"},
  "trigger.toggle.crash-capture": {"icon":"󱚡","label":"Crash Capture","action":"omnixy-toggle-crash-capture"},
  "trigger.toggle.screensaver": {"icon":"󱄄","label":"Screensaver","action":"omnixy-toggle-screensaver"},
  "trigger.toggle.nightlight": {"icon":"󰔎","label":"Nightlight","action":"omnixy-toggle-nightlight"},
  "trigger.toggle.top-bar": {"icon":"󰍜","label":"Menu Bar","action":"omnixy-toggle-bar"},
  "trigger.toggle.battery-percentage": {"icon":"󰁹","label":"Battery Percentage","when":"omnixy-hw-laptop","action":"omnixy-shell omnixy.power togglePercentage"},
  "trigger.toggle.workspace-layout": {"icon":"󱂬","label":"Workspace Layout","action":"omnixy-hyprland-workspace-layout-toggle"},
  "trigger.toggle.window-gaps": {"icon":"","label":"Window Gaps","action":"omnixy-hyprland-window-gaps-toggle"},
  "trigger.toggle.one-window-ratio": {"icon":"","label":"1-Window Ratio","action":"omnixy-hyprland-window-single-square-aspect-toggle"},
  "trigger.tests.network-speedtest": {"icon":"󰓅","label":"Network Speed Test","action":"omnixy-shell shell summon omnixy.speedtest"},
  "trigger.tests.disk-speedtest": {"icon":"󰋊","label":"Disk Speed Test","action":"omnixy-shell shell summon omnixy.disk-speedtest"},

  // Style
  "style.theme": {"icon":"󰸌","label":"Theme","aliases":["theme","themes"],"action":"theme=$(omnixy-theme-switcher); [[ -n $theme ]] && omnixy-theme-set \"$theme\""},
  "style.background": {"icon":"","label":"Background","aliases":["background","wallpaper"],"action":"background=$(omnixy-theme-bg-switcher); [[ -n $background ]] && omnixy-theme-bg-set \"$background\""},
  "style.unlock": {"icon":"󰟵","label":"Unlock","aliases":["unlock"],"action":"unlock=$(omnixy-plymouth-switcher); if [[ $unlock == default ]]; then omnixy-launch-floating-terminal-with-presentation omnixy-plymouth-reset; elif [[ -n $unlock ]]; then omnixy-launch-floating-terminal-with-presentation \"omnixy-plymouth-set-by-theme $(printf %q \"$unlock\")\"; fi"},
  "style.font": {"icon":"","label":"Font","provider":"fonts"},
  "style.bar": {"icon":"󰍜","label":"Menu Bar"},
  "style.bar.position": {"icon":"","label":"Position"},
  "style.bar.transparency": {"icon":"󰂵","label":"Transparency","action":"omnixy-bar transparent toggle"},
  "style.hyprland": {"icon":"","label":"Hyprland","action":"omnixy-launch-config-editor \"$HOME/.config/hypr/looknfeel.lua\""},
  "style.screensaver": {"icon":"󱄄","label":"Screensaver"},
  "style.about": {"icon":"","label":"About"},
  "style.bar.position.top": {"icon":"󰁝","label":"Top","action":"omnixy-bar position top"},
  "style.bar.position.bottom": {"icon":"󰁅","label":"Bottom","action":"omnixy-bar position bottom"},
  "style.bar.position.left": {"icon":"󰁍","label":"Left","action":"omnixy-bar position left"},
  "style.bar.position.right": {"icon":"󰁔","label":"Right","action":"omnixy-bar position right"},
  "style.about.text": {"icon":"","label":"Edit Text","action":"omnixy-branding-about text"},
  "style.about.image": {"icon":"","label":"Set From Image","action":"omnixy-branding-about image"},
  "style.about.default": {"icon":"","label":"Restore Default","action":"omnixy-branding-about reset"},
  "style.screensaver.text": {"icon":"","label":"Edit Text","action":"omnixy-branding-screensaver text"},
  "style.screensaver.image": {"icon":"","label":"Set From Image","action":"omnixy-branding-screensaver image"},
  "style.screensaver.default": {"icon":"","label":"Restore Default","action":"omnixy-branding-screensaver reset"},

  // Setup
  "setup.monitors": {"icon":"󰍹","label":"Monitors","action":"omnixy-launch-config-editor \"$HOME/.config/hypr/monitors.lua\""},
  "setup.keybindings": {"icon":"","label":"Keybindings","when":"[[ -f ~/.config/hypr/bindings.lua ]]","action":"omnixy-launch-config-editor \"$HOME/.config/hypr/bindings.lua\""},
  "setup.input": {"icon":"","label":"Input","when":"[[ -f ~/.config/hypr/input.lua ]]","action":"omnixy-launch-config-editor \"$HOME/.config/hypr/input.lua\""},
  "setup.network": {"icon":"󰛳","label":"Network","aliases":["network"]},
  "setup.network.dns": {"icon":"󰇖","label":"DNS","aliases":["dns"]},
  "setup.network.dns.dhcp": {"icon":"󰩟","label":"DHCP","checked":"[[ \"$(omnixy-dns)\" == \"DHCP\" ]]","action":"omnixy-dns DHCP"},
  "setup.network.dns.cloudflare": {"icon":"󰅟","label":"Cloudflare","checked":"[[ \"$(omnixy-dns)\" == \"Cloudflare\" ]]","action":"omnixy-dns Cloudflare"},
  "setup.network.dns.google": {"icon":"󰊭","label":"Google","checked":"[[ \"$(omnixy-dns)\" == \"Google\" ]]","action":"omnixy-dns Google"},
  "setup.network.dns.custom": {"icon":"","label":"Custom","checked":"[[ \"$(omnixy-dns)\" == \"Custom\" ]]","action":"omnixy-launch-floating-terminal-with-presentation 'omnixy-dns Custom'"},
  "setup.network.qr": {"icon":"󰐲","label":"QR Code","aliases":["wifi-qr"],"when":"[[ $(omnixy-network-status) == wifi* ]]","action":"omnixy-shell shell summon omnixy.wifiqr"},
  "setup.default": {"icon":"","label":"Defaults","aliases":["default","defaults"]},
  "setup.default.agent": {"icon":"󰚩","label":"Agent","title":"Default Agent"},
  "setup.default.agent.claude": {"icon":"󰛄","label":"Claude","checked":"[[ \"$(omnixy-default-agent)\" == \"claude\" ]]","action":"omnixy-default-agent claude"},
  "setup.default.agent.codex": {"icon":"","iconFont":"omnixy","label":"Codex","checked":"[[ \"$(omnixy-default-agent)\" == \"codex\" ]]","action":"omnixy-default-agent codex"},
  "setup.default.agent.copilot": {"icon":"","label":"Copilot","checked":"[[ \"$(omnixy-default-agent)\" == \"copilot\" ]]","action":"omnixy-default-agent copilot"},
  "setup.default.agent.crush": {"icon":"󰋑","label":"Crush","checked":"[[ \"$(omnixy-default-agent)\" == \"crush\" ]]","action":"omnixy-default-agent crush"},
  "setup.default.agent.gemini": {"icon":"󰫢","label":"Gemini","checked":"[[ \"$(omnixy-default-agent)\" == \"gemini\" ]]","action":"omnixy-default-agent gemini"},
  "setup.default.agent.grok": {"icon":"","iconFont":"omnixy","label":"Grok","checked":"[[ \"$(omnixy-default-agent)\" == \"grok\" ]]","action":"omnixy-default-agent grok"},
  "setup.default.agent.omp": {"icon":"","iconFont":"omnixy","label":"omp","checked":"[[ \"$(omnixy-default-agent)\" == \"omp\" ]]","action":"omnixy-default-agent omp"},
  "setup.default.agent.opencode": {"icon":"","iconFont":"omnixy","label":"OpenCode","checked":"[[ \"$(omnixy-default-agent)\" == \"opencode\" ]]","action":"omnixy-default-agent opencode"},
  "setup.default.agent.pi": {"icon":"","iconFont":"omnixy","label":"Pi","checked":"[[ \"$(omnixy-default-agent)\" == \"pi\" ]]","action":"omnixy-default-agent pi"},
  "setup.default.browser": {"icon":"","label":"Browser","title":"Default Browser"},
  "setup.default.browser.chromium": {"icon":"","label":"Chromium","when":"omnixy-cmd-present chromium","checked":"[[ \"$(omnixy-default-browser)\" == \"chromium\" ]]","action":"omnixy-default-browser chromium"},
  "setup.default.browser.chrome": {"icon":"󰊯","label":"Chrome","when":"omnixy-cmd-present google-chrome-stable","checked":"[[ \"$(omnixy-default-browser)\" == \"chrome\" ]]","action":"omnixy-default-browser chrome"},
  "setup.default.browser.brave": {"icon":"󰖟","label":"Brave","when":"omnixy-cmd-present brave","checked":"[[ \"$(omnixy-default-browser)\" == \"brave\" ]]","action":"omnixy-default-browser brave"},
  "setup.default.browser.brave-origin": {"icon":"󰖟","label":"Brave Origin","when":"omnixy-cmd-present brave-origin","checked":"[[ \"$(omnixy-default-browser)\" == \"brave-origin\" ]]","action":"omnixy-default-browser brave-origin"},
  "setup.default.browser.edge": {"icon":"󰇩","label":"Edge","when":"omnixy-cmd-present microsoft-edge-stable","checked":"[[ \"$(omnixy-default-browser)\" == \"edge\" ]]","action":"omnixy-default-browser edge"},
  "setup.default.browser.firefox": {"icon":"","label":"Firefox","when":"omnixy-cmd-present firefox","checked":"[[ \"$(omnixy-default-browser)\" == \"firefox\" ]]","action":"omnixy-default-browser firefox"},
  "setup.default.browser.zen": {"icon":"󰖟","label":"Zen","when":"omnixy-cmd-present zen-browser","checked":"[[ \"$(omnixy-default-browser)\" == \"zen\" ]]","action":"omnixy-default-browser zen"},
  "setup.default.terminal": {"icon":"","label":"Terminal","title":"Default Terminal"},
  "setup.default.terminal.alacritty": {"icon":"","label":"Alacritty","when":"omnixy-cmd-present alacritty","checked":"[[ \"$(omnixy-default-terminal)\" == \"alacritty\" ]]","action":"omnixy-default-terminal alacritty"},
  "setup.default.terminal.foot": {"icon":"","label":"Foot","when":"omnixy-cmd-present foot","checked":"[[ \"$(omnixy-default-terminal)\" == \"foot\" ]]","action":"omnixy-default-terminal foot"},
  "setup.default.terminal.ghostty": {"icon":"","label":"Ghostty","when":"omnixy-cmd-present ghostty","checked":"[[ \"$(omnixy-default-terminal)\" == \"ghostty\" ]]","action":"omnixy-default-terminal ghostty"},
  "setup.default.terminal.kitty": {"icon":"","label":"Kitty","when":"omnixy-cmd-present kitty","checked":"[[ \"$(omnixy-default-terminal)\" == \"kitty\" ]]","action":"omnixy-default-terminal kitty"},
  "setup.default.editor": {"icon":"","label":"Editor","title":"Default Editor"},
  "setup.default.editor.neovim": {"icon":"","label":"Neovim","when":"omnixy-cmd-present nvim","checked":"[[ \"$(omnixy-default-editor)\" == \"nvim\" ]]","action":"omnixy-default-editor nvim"},
  "setup.default.editor.vscode": {"icon":"","label":"VSCode","when":"omnixy-cmd-present code","checked":"[[ \"$(omnixy-default-editor)\" == \"code\" ]]","action":"omnixy-default-editor code"},
  "setup.default.editor.cursor": {"icon":"","label":"Cursor","when":"omnixy-cmd-present cursor","checked":"[[ \"$(omnixy-default-editor)\" == \"cursor\" ]]","action":"omnixy-default-editor cursor"},
  "setup.default.editor.zed": {"icon":"","label":"Zed","when":"omnixy-cmd-present zeditor","checked":"[[ \"$(omnixy-default-editor)\" == \"zeditor\" ]]","action":"omnixy-default-editor zed"},
  "setup.default.editor.sublime": {"icon":"","label":"Sublime Text","when":"omnixy-cmd-present sublime_text","checked":"[[ \"$(omnixy-default-editor)\" == \"sublime_text\" ]]","action":"omnixy-default-editor sublime_text"},
  "setup.default.editor.helix": {"icon":"","label":"Helix","when":"omnixy-cmd-present helix","checked":"[[ \"$(omnixy-default-editor)\" == \"helix\" ]]","action":"omnixy-default-editor helix"},
  "setup.default.editor.vim": {"icon":"","label":"Vim","when":"omnixy-cmd-present vim","checked":"[[ \"$(omnixy-default-editor)\" == \"vim\" ]]","action":"omnixy-default-editor vim"},
  "setup.default.editor.emacs": {"icon":"","label":"Emacs","when":"omnixy-cmd-present emacs","checked":"[[ \"$(omnixy-default-editor)\" == \"emacs\" ]]","action":"omnixy-default-editor emacs"},
  "setup.plugin": {"icon":"󰐱","label":"Plugins","aliases":["plugin","plugins"]},
  "setup.plugin.enable": {"icon":"󰄬","label":"Enable Plugin","action":"omnixy-menu-plugin enable"},
  "setup.plugin.disable": {"icon":"󰅖","label":"Disable Plugin","action":"omnixy-menu-plugin disable"},
  "setup.plugin.add": {"icon":"󰖟","label":"Add Plugin","action":"omnixy-launch-floating-terminal-with-presentation 'omnixy-plugin-add'"},
  "setup.plugin.clone": {"icon":"󰆏","label":"Clone Plugin","action":"omnixy-menu-plugin clone"},
  "setup.plugin.remove": {"icon":"󰭌","label":"Remove Plugin","when":"compgen -G \"$HOME/.config/omnixy/plugins/*/manifest.json\"","action":"omnixy-menu-plugin remove"},
  "setup.security": {"icon":"","label":"Security"},
  "setup.config": {"icon":"","label":"Config"},
  "setup.security.fingerprint": {"icon":"󰈷","label":"Fingerprint","when":"omnixy-hw-fingerprint","action":"omnixy-launch-floating-terminal-with-presentation omnixy-setup-security-fingerprint"},
  "setup.security.fido2": {"icon":"","label":"Fido2","action":"omnixy-launch-floating-terminal-with-presentation omnixy-setup-security-fido2"},
  "setup.security.sshd": {"icon":"󰣀","label":"SSHD","action":"omnixy-launch-floating-terminal-with-presentation omnixy-setup-security-sshd"},
  "setup.security.passwordless-sudo": {"icon":"󰟵","label":"Passwordless Sudo","action":"omnixy-launch-floating-terminal-with-presentation omnixy-sudo-passwordless"},
  "setup.security.sudoless-docker": {"icon":"󰡨","label":"Sudoless Docker","when":"omnixy-sudo-docker --configured","action":"omnixy-launch-floating-terminal-with-presentation omnixy-setup-security-sudoless-docker"},
  "setup.config.hyprland": {"icon":"","label":"Hyprland","action":"omnixy-launch-config-editor \"$HOME/.config/hypr/hyprland.lua\""},
  "setup.config.hyprsunset": {"icon":"","label":"Hyprsunset","action":"omnixy-launch-config-editor ~/.config/hypr/hyprsunset.conf && omnixy-restart-hyprsunset"},
  "setup.config.xcompose": {"icon":"󰞅","label":"XCompose","action":"omnixy-launch-config-editor ~/.XCompose && omnixy-restart-xcompose"},
  "setup.direct-boot": {"icon":"","label":"Direct Boot","action":"omnixy-launch-floating-terminal-with-presentation omnixy-setup-direct-boot"},
  "setup.reset": {"icon":"󰑓","label":"Reset Computer","when":"[[ $(findmnt -no FSTYPE /) == btrfs ]]","action":"omnixy-launch-floating-terminal-with-presentation omnixy-system-factory-reset"},

  // Install

  // Remove

  // Update
}
