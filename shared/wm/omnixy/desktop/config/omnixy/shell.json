{
  "version": 1,
  "idle": {
    "screensaver": 150,
    "lock": 300
  },
  "bar": {
    "position": "top",
    "transparent": false,
    "centerAnchor": "omnixy.clock",
    "layout": {
      "left": [
        {
          "id": "omnixy.menu"
        },
        {
          "id": "omnixy.workspaces"
        }
      ],
      "center": [
        {
          "id": "omnixy.indicators"
        },
        {
          "id": "omnixy.clock",
          "format": "dddd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "HH\n\u2014\nmm"
        },
        {
          "id": "omnixy.keyboard-layout"
        },
        {
          "id": "omnixy.weather"
        },
        {
          "id": "omnixy.system-update"
        }
      ],
      "right": [
        {
          "id": "omnixy.tray"
        },
        {
          "id": "omnixy.agents"
        },
        {
          "id": "omnixy.bluetooth"
        },
        {
          "id": "omnixy.network"
        },
        {
          "id": "omnixy.audio"
        },
        {
          "id": "omnixy.monitor"
        },
        {
          "id": "omnixy.power"
        }
      ]
    }
  },
  "plugins": []
}
